#!/usr/bin/env python3
# swizzin panel — fail2ban collector
# Runs as root from swizzin-f2b.timer and writes jail status plus recent bans to
# /var/lib/swizzin/fail2ban.json for the unprivileged panel. Read-only towards fail2ban.
# Part of the sheergood/swizzin fork. Licensed under GNU GPL v3.
import json
import os
import re
import shutil
import sqlite3
import subprocess
import tempfile
import time

OUT = "/var/lib/swizzin/fail2ban.json"
DB = "/var/lib/fail2ban/fail2ban.sqlite3"
RECENT = 60


def client(*args):
    try:
        return subprocess.run(["fail2ban-client"] + list(args), stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, universal_newlines=True, timeout=15).stdout
    except Exception:
        return ""


def field(text, name):
    m = re.search(r"{}:\s*(.*)".format(re.escape(name)), text)
    return m.group(1).strip() if m else ""


LOG_TAIL = 4 << 20       # bytes of fail2ban's log read for "failing now"
FOUND = re.compile(r"^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d,\d+ fail2ban\.filter\s+\[\d+\]:\s+INFO\s+\[([^\]]+)\] Found (\S+) - "
                   r"(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)")
BAN = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d),\d+ fail2ban\.actions\s+\[\d+\]:\s+NOTICE\s+\[([^\]]+)\] (?:Restore )?Ban (\S+)")


def logtarget():
    out = client("get", "logtarget")
    m = re.search(r"(/\S+)", out)
    path = m.group(1) if m else "/var/log/fail2ban.log"
    return path if os.path.isfile(path) else None


def _ts(text):
    try:
        return int(time.mktime(time.strptime(text, "%Y-%m-%d %H:%M:%S")))
    except ValueError:
        return None


def failing(path, jails, banned_now, now):
    """Addresses that failed in a jail within its findtime and aren't banned (yet): from fail2ban's
    own "Found" lines, counting only what came after that address's last ban in that jail."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - LOG_TAIL))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []
    last_ban, hits = {}, {}
    for line in lines:
        m = BAN.match(line)
        if m:
            t = _ts(m.group(1))
            if t:
                last_ban[(m.group(2), m.group(3))] = t
                hits.pop((m.group(2), m.group(3)), None)
            continue
        m = FOUND.match(line)
        if m and m.group(1) in jails:
            t = _ts(m.group(3))
            if t:
                hits.setdefault((m.group(1), m.group(2)), []).append(t)
    out = []
    for (jail, ip), times in hits.items():
        findtime, maxretry = jails[jail]
        times = [t for t in times if t > now - findtime and t > last_ban.get((jail, ip), 0)]
        if times and ip not in banned_now.get(jail, set()):
            out.append({"ip": ip, "jail": jail, "count": len(times), "maxretry": maxretry, "last": max(times)})
    out.sort(key=lambda x: x["last"], reverse=True)
    return out[:50]


def _int(text, default):
    m = re.search(r"-?\d+", text or "")
    return int(m.group(0)) if m else default


def main():
    now = int(time.time())
    data = {"updated": now, "running": False, "jails": [], "recent": [], "bans_24h": 0, "bans_7d": 0}
    if shutil.which("fail2ban-client"):
        status = client("status")
        data["running"] = "Jail list" in status
        names = [j.strip() for j in field(status, "Jail list").split(",") if j.strip()]
        banned_now = {}
        for name in names:
            st = client("status", name)
            ips = field(st, "Banned IP list").split()
            banned_now[name] = set(ips)
            data["jails"].append({
                "name": name,
                "currently_banned": int(field(st, "Currently banned") or 0),
                "total_banned": int(field(st, "Total banned") or 0),
                "currently_failed": int(field(st, "Currently failed") or 0),
                "total_failed": int(field(st, "Total failed") or 0),
            })
        data["banned_now"] = sum(j["currently_banned"] for j in data["jails"])
        # which addresses are behind "failing now"
        path = logtarget()
        if path:
            limits = {j["name"]: (_int(client("get", j["name"], "findtime"), 600), _int(client("get", j["name"], "maxretry"), 5))
                      for j in data["jails"] if j["currently_failed"]}
            data["failing"] = failing(path, limits, banned_now, now) if limits else []
        if os.path.exists(DB):
            try:
                con = sqlite3.connect("file:{}?mode=ro".format(DB), uri=True, timeout=5)
                con.row_factory = sqlite3.Row
                cols = {r[1] for r in con.execute("PRAGMA table_info(bans)")}
                rows = con.execute("SELECT * FROM bans ORDER BY timeofban DESC LIMIT ?", (RECENT,)).fetchall()
                for r in rows:
                    bantime = r["bantime"] if "bantime" in cols else None
                    data["recent"].append({
                        "ip": r["ip"], "jail": r["jail"], "time": r["timeofban"],
                        "bantime": bantime, "count": r["bancount"] if "bancount" in cols else None,
                        "failures": (json.loads(r["data"]).get("failures") if r["data"] else None)
                        if "data" in cols else None,
                        "active": r["ip"] in banned_now.get(r["jail"], set()),
                    })
                data["bans_24h"] = con.execute("SELECT COUNT(*) FROM bans WHERE timeofban > ?", (now - 86400,)).fetchone()[0]
                data["bans_7d"] = con.execute("SELECT COUNT(*) FROM bans WHERE timeofban > ?", (now - 7 * 86400,)).fetchone()[0]
                # bans per address over 7 days, for the dashboard's "bans by country" (top addresses only)
                data["ips_7d"] = [[r[0], r[1]] for r in con.execute(
                    "SELECT ip, COUNT(*) FROM bans WHERE timeofban > ? GROUP BY ip ORDER BY 2 DESC LIMIT 500",
                    (now - 7 * 86400,)).fetchall()]
                con.close()
            except Exception as e:
                data["db_error"] = str(e)
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(OUT), prefix=".f2b.")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, OUT)


if __name__ == "__main__":
    main()
