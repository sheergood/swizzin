#!/bin/bash
# The only update commands the panel (user swizzin) may run as root:
#   panel-upgrade check    start the app update check now (returns at once)
#   panel-upgrade <app>    upgrade one app
# Accepts autobrr, filebrowser, fbquantum, plex, navidrome, netronome, emby, lounge, jellyfin or ombi
# (installed ones only), refuses while another upgrade
# or a box command is running, then starts the upgrade as its own systemd job (panel-upgrade-run), so
# it finishes even if the panel restarts. Prints "started" and returns at once.
# Sonarr/Radarr/Prowlarr/Lidarr update themselves through their own API; torrent clients and their
# web UIs are never upgraded here.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

app=${1:-}
if (($# != 1)); then
    echo "usage: panel-upgrade check | <autobrr|filebrowser|fbquantum|plex|navidrome|netronome|emby|lounge|jellyfin|ombi>" >&2
    exit 2
fi
if [[ $app == check ]]; then
    systemctl start --no-block swizzin-updates.service
    echo started
    exit 0
fi
case "$app" in
    autobrr | filebrowser | fbquantum | plex | navidrome | netronome | emby | lounge | jellyfin | ombi) ;;
    *)
        echo "panel-upgrade: $app can't be upgraded from the panel" >&2
        exit 2
        ;;
esac
if [[ ! -f /install/.${app}.lock ]]; then
    echo "panel-upgrade: $app isn't installed" >&2
    exit 3
fi
# one caller at a time from here to the job being queued, so two quick clicks can't start two upgrades
exec 9> /run/swizzin-panel-upgrade.lock
if ! flock -w 10 9; then
    echo "panel-upgrade: another upgrade is starting" >&2
    exit 4
fi
running=$(systemctl list-units --no-legend --plain 'swizzin-upgrade-*' 2> /dev/null || true)
if [[ $running == *swizzin-upgrade-* ]]; then
    echo "panel-upgrade: another upgrade is running" >&2
    exit 4
fi
if pgrep -f '/usr/local/bin/box( |$)' > /dev/null 2>&1; then
    echo "panel-upgrade: a box command is running on the server; try again when it's done" >&2
    exit 4
fi
systemd-run --unit="swizzin-upgrade-${app}" --description="swizzin panel: upgrade ${app}" --collect --quiet \
    -p TimeoutStartSec=3600 -p Type=oneshot --no-block /etc/swizzin/scripts/panel-upgrade-run "$app"
echo started
