#!/usr/bin/env bash
# Helpers for FileBrowser Quantum (https://github.com/gtsteffaniak/filebrowser), shared by the
# install and upgrade scripts. Only "-stable" releases are used; betas are skipped.

FBQ_REPO="gtsteffaniak/filebrowser"
FBQ_BIN="/opt/fbquantum/filebrowser"

fbquantum_asset() {
    case "$(_os_arch)" in
        amd64) echo "linux-amd64-filebrowser" ;;
        arm64) echo "linux-arm64-filebrowser" ;;
        armhf) echo "linux-arm-7-filebrowser" ;;
        *) return 1 ;;
    esac
}

# Prints "<tag> <download url> <sha256 or empty>" for the newest stable release.
fbquantum_latest_stable() {
    local asset json
    asset="$(fbquantum_asset)" || { echo_error "$(_os_arch) is not supported by FileBrowser Quantum" >&2; return 1; }
    command -v jq > /dev/null 2>&1 || apt_install jq >&2
    json="$(curl -fsSL --retry 3 -m 60 "https://api.github.com/repos/${FBQ_REPO}/releases?per_page=40")" || return 1
    jq -r --arg a "$asset" '
        [ .[] | select((.tag_name | endswith("-stable")) and (.draft | not)) ][0]
        | . as $r | ($r.assets[] | select(.name == $a)) as $f
        | "\($r.tag_name) \($f.browser_download_url) \(($f.digest // "") | sub("^sha256:"; ""))"' <<< "$json"
}

fbquantum_installed_version() {
    [[ -x $FBQ_BIN ]] && "$FBQ_BIN" version 2> /dev/null | awk '/Version/ {print $3; exit}'
}

# Downloads the newest stable binary, checks it, and installs it to $FBQ_BIN. Prints only the tag on
# stdout (messages go to stderr), so callers can use tag="$(fbquantum_fetch)".
# The previous binary is kept as $FBQ_BIN.bak so a failed upgrade can be rolled back.
fbquantum_fetch() {
    local tag url sum tmp
    read -r tag url sum <<< "$(fbquantum_latest_stable)"
    if [[ -z $tag || -z $url || $url == null ]]; then
        echo_error "Could not find a stable FileBrowser Quantum release for $(_os_arch)" >&2
        return 1
    fi
    tmp="$(mktemp)"
    echo_log_only "Downloading FileBrowser Quantum ${tag} from ${url}" >&2
    if ! curl -fsSL --retry 3 -m 600 -o "$tmp" "$url" >> "${log:-/dev/null}" 2>&1; then
        rm -f "$tmp"
        echo_error "Download of FileBrowser Quantum ${tag} failed" >&2
        return 1
    fi
    if [[ -n $sum ]] && ! echo "${sum}  ${tmp}" | sha256sum -c --quiet - >> "${log:-/dev/null}" 2>&1; then
        rm -f "$tmp"
        echo_error "Checksum mismatch for FileBrowser Quantum ${tag}; nothing was changed" >&2
        return 1
    fi
    chmod 755 "$tmp"
    if ! "$tmp" version 2> /dev/null | grep -q "Version"; then
        rm -f "$tmp"
        echo_error "The downloaded FileBrowser Quantum binary does not run on this system; nothing was changed" >&2
        return 1
    fi
    mkdir -p /opt/fbquantum
    [[ -f $FBQ_BIN ]] && cp -p "$FBQ_BIN" "${FBQ_BIN}.bak"
    mv -f "$tmp" "$FBQ_BIN"
    chown root:root "$FBQ_BIN"
    chmod 755 "$FBQ_BIN"
    echo_log_only "Installed FileBrowser Quantum ${tag}" >&2
    echo "$tag"
}

FBQ_SOCK="/run/fbquantum/fbquantum.sock"
# Bump when fbquantum_write_config changes; box upgrade rewrites older configs.
#   1 = TCP port + separate Quantum login   2 = single sign-on (Nov 27 2026)
#   3 = + share/API/file permissions for the account
FBQ_CONFIG_VERSION=3

fbquantum_config_version() {
    local v
    v="$(grep -oE 'swizzin-fbquantum-config: [0-9]+' "$1" 2> /dev/null | grep -oE '[0-9]+$')"
    if [[ -n $v ]]; then echo "$v"; elif grep -q 'X-Swizzin-User' "$1" 2> /dev/null; then echo 2; else echo 1; fi
}

# Settings for /home/<user>/.config/fbquantum/config.yaml.
#
# Sign-in is single sign-on through swizzin: nginx checks the swizzin login (the same browser login the
# dashboard uses) and passes the user name in X-Swizzin-User. Quantum must never answer a signed-in
# browser with 401 of its own: browsers treat that as "the cached swizzin password is wrong", forget
# it and log you out of the dashboard too. Quantum therefore listens only on a unix socket that just
# nginx (group www-data), the master user and root can open, so nobody else can send that header.
fbquantum_write_config() {
    local username="$1" confdir="$2" wwwgid
    wwwgid="$(getent group www-data | cut -d: -f3)"
    mkdir -p "${confdir}/cache"
    cat > "${confdir}/config.yaml" << CONFIG
# FileBrowser Quantum — https://filebrowserquantum.com/en/docs/configuration/
# Written by swizzin (box install / box upgrade fbquantum). Restart after editing: systemctl restart fbquantum
# swizzin-fbquantum-config: ${FBQ_CONFIG_VERSION}
http:
  socket: "${FBQ_SOCK}"         # only nginx (www-data), ${username} and root can connect
  socketFileMode: "0660"
  socketGroup: "www-data"
  unixSocketTrustedGIDs: [${wwwgid:-33}]
  trustProxyHeaders: true
  baseURL: "/fbquantum/"
server:
  disableUpdateCheck: true      # updates come from: box upgrade fbquantum
  cacheDir: "${confdir}/cache"
  database:
    path: "${confdir}/fbquantum.db"
  sources:
    - path: "/home/${username}"
      name: "${username}"
      config:
        defaultEnabled: true
        defaultPermissions:     # your own home folder: full access
          view: true
          download: true
          create: true
          modify: true
          delete: true
  logging:
    - levels: "info|warning|error"
userDefaults:                   # the account created at your first visit
  account:
    permissions:
      api: true
      share: true
      realtime: true
auth:
  methods:
    proxy:
      enabled: true
      header: "X-Swizzin-User"  # set by nginx after the swizzin login
      groupsClaim: "X-Swizzin-Groups"
      adminGroup: "swizzin-admin"
      logoutRedirectUrl: "/logout"
    password:
      enabled: false            # sign-in is the swizzin login; there is no separate password to leak
CONFIG
    chown -R "${username}:" "$confdir"
    chmod 700 "$confdir"
}

fbquantum_write_unit() {
    local username="$1" confdir="$2"
    cat > /etc/systemd/system/fbquantum.service << SERVICE
[Unit]
Description=FileBrowser Quantum
After=network.target

[Service]
User=${username}
Group=${username}
# lets the service give its socket to nginx's group
SupplementaryGroups=www-data
RuntimeDirectory=fbquantum
RuntimeDirectoryMode=0711
UMask=002
Type=simple
WorkingDirectory=${confdir}
ExecStart=${FBQ_BIN} -c ${confdir}/config.yaml
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
SERVICE
    systemctl daemon-reload
}

# Waits up to ~30 s for the web UI to answer on its socket.
fbquantum_healthy() {
    local _ code
    for _ in $(seq 1 30); do
        code="$(curl -s -o /dev/null -m 3 -w '%{http_code}' --unix-socket "$FBQ_SOCK" "http://localhost/fbquantum/" 2> /dev/null)"
        [[ $code == 200 ]] && return 0
        sleep 1
    done
    return 1
}
