#!/bin/bash
# Panel helpers for the sheergood/swizzin fork

# Where the dashboard is cloned from. Override with PANEL_REPO / PANEL_BRANCH in the environment.
PANEL_REPO="${PANEL_REPO:-https://github.com/sheergood/swizzin_dashboard.git}"
PANEL_BRANCH="${PANEL_BRANCH:-master}"

# /opt/swizzin belongs to the swizzin user. Git (>= 2.35.2) refuses to touch a repo owned by
# another user ("dubious ownership"), so every git call on it must run as swizzin, never as root.
function panel_git() {
    sudo -u swizzin git -C /opt/swizzin "$@"
}

# Install smartmontools and a root timer that feeds SMART data to the glass dashboard.
function panel_smart_setup() {
    apt_install smartmontools
    mkdir -p /var/lib/swizzin/smart

    cat > /etc/systemd/system/swizzin-smart.service << 'EOSVC'
[Unit]
Description=swizzin panel SMART collector
Documentation=https://github.com/sheergood/swizzin

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
ExecStart=/bin/bash /etc/swizzin/scripts/panel-smart-collect
EOSVC

    cat > /etc/systemd/system/swizzin-smart.timer << 'EOTMR'
[Unit]
Description=Refresh SMART data for the swizzin panel every 10 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=10min
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
EOTMR

    systemctl daemon-reload
    systemctl enable -q --now swizzin-smart.timer >> ${log} 2>&1
    systemctl start swizzin-smart.service >> ${log} 2>&1 || true
}

# Root timer that snapshots fail2ban jail status and recent bans for the dashboard's Security card.
function panel_f2b_setup() {
    mkdir -p /var/lib/swizzin
    cat > /etc/systemd/system/swizzin-f2b.service << 'EOSVC'
[Unit]
Description=swizzin panel fail2ban snapshot
Documentation=https://github.com/sheergood/swizzin
After=fail2ban.service

[Service]
Type=oneshot
Nice=10
ExecStart=/usr/bin/python3 /etc/swizzin/scripts/panel-f2b-collect
EOSVC

    cat > /etc/systemd/system/swizzin-f2b.timer << 'EOTMR'
[Unit]
Description=Refresh fail2ban data for the swizzin panel every 2 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
EOTMR

    systemctl daemon-reload
    systemctl enable -q --now swizzin-f2b.timer >> ${log} 2>&1
    systemctl start swizzin-f2b.service >> ${log} 2>&1 || true
}

function panel_f2b_remove() {
    systemctl disable -q --now swizzin-f2b.timer > /dev/null 2>&1
    rm -f /etc/systemd/system/swizzin-f2b.service /etc/systemd/system/swizzin-f2b.timer /var/lib/swizzin/fail2ban.json
    systemctl daemon-reload
}

# Root timer for things only root can read: memory module details (dmidecode) for the server specs
# popover, and Plex's local token (0640 root:swizzin) for the "Now playing" card.
function panel_host_setup() {
    mkdir -p /var/lib/swizzin
    command -v dmidecode > /dev/null 2>&1 || apt_install dmidecode
    cat > /etc/systemd/system/swizzin-host.service << 'EOSVC'
[Unit]
Description=swizzin panel host info snapshot
Documentation=https://github.com/sheergood/swizzin

[Service]
Type=oneshot
Nice=10
ExecStart=/usr/bin/python3 /etc/swizzin/scripts/panel-host-collect
EOSVC

    cat > /etc/systemd/system/swizzin-host.timer << 'EOTMR'
[Unit]
Description=Refresh host info for the swizzin panel hourly

[Timer]
OnBootSec=1min
OnUnitActiveSec=1h

[Install]
WantedBy=timers.target
EOTMR

    systemctl daemon-reload
    systemctl enable -q --now swizzin-host.timer >> ${log} 2>&1
    systemctl start swizzin-host.service >> ${log} 2>&1 || true
}

function panel_host_remove() {
    systemctl disable -q --now swizzin-host.timer > /dev/null 2>&1
    rm -f /etc/systemd/system/swizzin-host.service /etc/systemd/system/swizzin-host.timer \
        /var/lib/swizzin/hostinfo.json /var/lib/swizzin/plex-token /var/lib/swizzin/arr.json
    systemctl daemon-reload
}

# App update check for the panel: every 6 hours (and on "Check now") panel-updates-check compares
# installed versions with the newest releases and writes /var/lib/swizzin/updates.json. Upgrades
# started from the panel go through panel-upgrade (see panel_sudoers). Checking installs nothing.
function panel_updates_setup() {
    mkdir -p /var/lib/swizzin
    cat > /etc/systemd/system/swizzin-updates.service << 'EOSVC'
[Unit]
Description=swizzin panel app update check
Documentation=https://github.com/sheergood/swizzin
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
TimeoutStartSec=300
ExecStart=/usr/bin/python3 /etc/swizzin/scripts/panel-updates-check
EOSVC

    cat > /etc/systemd/system/swizzin-updates.timer << 'EOTMR'
[Unit]
Description=Check for app updates for the swizzin panel every 6 hours

[Timer]
OnBootSec=10min
OnUnitActiveSec=6h
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
EOTMR

    systemctl daemon-reload
    systemctl enable -q --now swizzin-updates.timer >> ${log} 2>&1
    systemctl start --no-block swizzin-updates.service >> ${log} 2>&1 || true
}

function panel_updates_remove() {
    systemctl disable -q --now swizzin-updates.timer > /dev/null 2>&1
    rm -f /etc/systemd/system/swizzin-updates.service /etc/systemd/system/swizzin-updates.timer \
        /var/lib/swizzin/updates.json
    rm -rf /var/lib/swizzin/upgrades
    systemctl daemon-reload
}

# fail2ban jails for the web side (sshd is left exactly as it is). Each one bans on 80/443 only:
#   swizzin-panel       8 wrong panel passwords in 10 min. The panel logs a failure once per IP +
#                       login + password per 10 min, so a browser repeating a stale saved password
#                       counts once; only guessing different passwords adds up.
#   swizzin-nginx-auth  10 wrong passwords for apps behind nginx's login (Sonarr, Radarr, ...) in
#                       10 min (fail2ban's stock nginx-http-auth filter: a first visit without a
#                       password never counts)
#   swizzin-filebrowser 8 wrong passwords in 10 min at Filebrowser's or FileBrowser Quantum's own
#                       login page (they don't use nginx's login; seen in nginx's access log)
#   swizzin-scan        2 requests in 1 h for well-known attack paths (wp-login.php, .env, .git/,
#                       phpMyAdmin, ...) that got an error answer
# Bans start at 1 h (1 day for scanners) and double for repeat offenders, up to 1 day.
# Loopback is never banned. Add your own addresses in
# /etc/fail2ban/jail.d/swizzin-web.local:   [DEFAULT]  /  swizzin_ignoreip = 203.0.113.7
# Nothing is changed unless fail2ban accepts the new configuration; otherwise the previous files
# come back.
PANEL_AUTH_LOG=/var/log/swizzin-panel/auth.log
PANEL_F2B_FILES=(/etc/fail2ban/jail.d/swizzin-web.conf /etc/fail2ban/filter.d/swizzin-panel.conf /etc/fail2ban/filter.d/swizzin-scan.conf
    /etc/fail2ban/filter.d/swizzin-filebrowser.conf)
# Writes the jail and filters into directory $1 (same layout as /etc/fail2ban); $2 = yes for the
# nginx jails
function panel_f2b_web_render() {
    local out=$1 nginx_jails=$2
    mkdir -p "$out/jail.d" "$out/filter.d"
    cat > "$out/filter.d/swizzin-panel.conf" << 'EOFILTER'
# managed by swizzin (panel_f2b_web_setup): wrong passwords at the swizzin panel.
# The panel writes only the time and the address, e.g.
#   2026-11-28T07:44:00+0530 swizzin-panel: login failed from 203.0.113.7
[Definition]
failregex = ^\s*swizzin-panel: login failed from <HOST>\s*$
ignoreregex =
datepattern = {^LN-BEG}%%Y-%%m-%%dT%%H:%%M:%%S%%z
EOFILTER
    cat > "$out/filter.d/swizzin-scan.conf" << 'EOFILTER'
# managed by swizzin (panel_f2b_web_setup): requests for well-known attack paths that nothing on a
# swizzin server serves, answered with an error (nginx access log, combined format)
[Definition]
_paths = wp-login\.php|xmlrpc\.php|wp-config\.php|wp-admin/|wp-includes/|wp-content/|\.env(?:[.?/]|(?= ))|\.git/|\.svn/|\.aws/|\.ssh/|phpmyadmin|phpMyAdmin|pma/|myadmin/|mysqladmin|boaform|cgi-bin/|vendor/phpunit|HNAP1|actuator/|_ignition/|solr/admin|owa/auth|autodiscover/autodiscover\.xml|setup\.cgi|shell\.php|eval-stdin\.php
failregex = ^<HOST> \S+ \S+ [^"]*"(?:GET|POST|HEAD|PUT|DELETE|OPTIONS|PROPFIND) (?:https?://[^/" ]+)?/(?:[^" ]*?/)?(?:%(_paths)s)[^" ]* HTTP/[0-9.]+" [45]\d\d\b
ignoreregex =
EOFILTER
    cat > "$out/filter.d/swizzin-filebrowser.conf" << 'EOFILTER'
# managed by swizzin (panel_f2b_web_setup): wrong passwords at Filebrowser (POST /filebrowser/api/login,
# answered 403) and FileBrowser Quantum (POST /fbquantum/api/auth/login, answered 401), nginx access log
[Definition]
failregex = ^<HOST> \S+ \S+ [^"]*"POST /(?:filebrowser/api/login|fbquantum/api/auth/login)(?:\?[^" ]*)? HTTP/[0-9.]+" (?:401|403)\b
ignoreregex =
EOFILTER
    _f2b_jail() { # name filter logpath maxretry findtime bantime
        printf '\n[%s]\nenabled = true\nfilter = %s\nbackend = auto\nlogpath = %s\nport = http,https\n' "$1" "$2" "$3"
        printf 'maxretry = %s\nfindtime = %s\nbantime = %s\nbantime.increment = true\nbantime.maxtime = 1d\n' "$4" "$5" "$6"
        printf 'ignoreip = 127.0.0.1/8 ::1 %%(swizzin_ignoreip)s\n'
    }
    {
        echo "# managed by swizzin (panel_f2b_web_setup); rewritten by box update."
        echo "# Your own additions go in swizzin-web.local, e.g. addresses that must never be banned:"
        echo "#   [DEFAULT]"
        echo "#   swizzin_ignoreip = 203.0.113.7 198.51.100.0/24"
        echo "[DEFAULT]"
        echo "swizzin_ignoreip ="
        _f2b_jail swizzin-panel swizzin-panel "$PANEL_AUTH_LOG" 8 10m 1h
        if [[ $nginx_jails == yes ]]; then
            _f2b_jail swizzin-nginx-auth nginx-http-auth /var/log/nginx/error.log 10 10m 1h
            _f2b_jail swizzin-filebrowser swizzin-filebrowser /var/log/nginx/access.log 8 10m 1h
            _f2b_jail swizzin-scan swizzin-scan /var/log/nginx/access.log 2 1h 1d
        fi
    } > "$out/jail.d/swizzin-web.conf"
    unset -f _f2b_jail
}

function panel_f2b_web_setup() {
    command -v fail2ban-client > /dev/null 2>&1 || return 0
    [[ -d /etc/fail2ban/jail.d && -d /etc/fail2ban/filter.d ]] || return 0
    local stage backup nginx_jails=no f changed=no rc=0
    # the panel's own failure log: written by the panel (user swizzin), read by fail2ban (root)
    mkdir -p /var/log/swizzin-panel
    chown swizzin:swizzin /var/log/swizzin-panel 2> /dev/null || true
    chmod 0750 /var/log/swizzin-panel
    if [[ ! -f $PANEL_AUTH_LOG ]]; then
        touch "$PANEL_AUTH_LOG"
        chown swizzin:swizzin "$PANEL_AUTH_LOG" 2> /dev/null || true
        chmod 0640 "$PANEL_AUTH_LOG"
    fi
    if [[ -d /var/log/nginx ]]; then
        for f in /var/log/nginx/error.log /var/log/nginx/access.log; do [[ -f $f ]] || touch "$f"; done
        nginx_jails=yes
    fi
    stage=$(mktemp -d /tmp/swizzin-f2b.XXXXXX) || return 1
    backup=$(mktemp -d /tmp/swizzin-f2b-prev.XXXXXX) || {
        rm -rf "$stage"
        return 1
    }
    panel_f2b_web_render "$stage" "$nginx_jails"
    for f in "${PANEL_F2B_FILES[@]}"; do
        cmp -s "${stage}${f#/etc/fail2ban}" "$f" || changed=yes
    done
    if [[ $changed == no ]]; then
        rm -rf "$stage" "$backup"
        return 0
    fi
    for f in "${PANEL_F2B_FILES[@]}"; do
        if [[ -f $f ]]; then cp -p "$f" "${backup}/${f##*/}"; fi
        install -m 0644 -o root -g root "${stage}${f#/etc/fail2ban}" "$f"
    done
    if ! fail2ban-client -t > /tmp/swizzin-f2b-test.log 2>&1; then
        rc=1
    elif systemctl is-active -q fail2ban; then
        if ! fail2ban-client reload >> "${log:-/dev/null}" 2>&1 || ! fail2ban-client status swizzin-panel > /dev/null 2>&1; then
            rc=1
        fi
    fi
    if ((rc)); then
        echo_warn "fail2ban didn't accept the new web jails; the previous fail2ban setup was restored (see /tmp/swizzin-f2b-test.log)"
        for f in "${PANEL_F2B_FILES[@]}"; do
            if [[ -f ${backup}/${f##*/} ]]; then cp -p "${backup}/${f##*/}" "$f"; else rm -f "$f"; fi
        done
        if systemctl is-active -q fail2ban; then fail2ban-client reload >> "${log:-/dev/null}" 2>&1 || true; fi
    fi
    rm -rf "$stage" "$backup"
    return $rc
}

function panel_f2b_web_remove() {
    local had=no f
    for f in "${PANEL_F2B_FILES[@]}"; do
        if [[ -f $f ]]; then had=yes; fi
        rm -f "$f"
    done
    rm -rf /var/log/swizzin-panel
    if [[ $had == yes ]] && systemctl is-active -q fail2ban 2> /dev/null; then
        fail2ban-client reload > /dev/null 2>&1 || true
    fi
}

# Port the panel listens on (swizzin.cfg can override the default 8333).
function panel_port() {
    local p
    p=$(grep -E '^\s*PORT\s*=' /opt/swizzin/swizzin.cfg 2> /dev/null | tail -n1 | grep -oE '[0-9]+')
    echo "${p:-8333}"
}

# 0 when the panel answers on its login page within ~20 s.
function panel_healthy() {
    local port i
    local base
    port=$(panel_port)
    base=$(grep -E '^\s*URLBASE\s*=' /opt/swizzin/swizzin.cfg 2> /dev/null | tail -n1 | sed -E "s/^[^=]*=\s*['\"]?([^'\"]*)['\"]?.*/\1/")
    base=${base%/}
    [[ $base == "/" ]] && base=""
    for i in $(seq 1 10); do
        sleep 2
        if curl -fs -o /dev/null --max-time 3 "http://127.0.0.1:${port}${base}/login"; then
            return 0
        fi
    done
    return 1
}

# Restart the panel and roll /opt/swizzin back to $1 (a commit) if it doesn't come up.
function panel_restart_or_rollback() {
    local previous=$1 current
    current=$(panel_git rev-parse HEAD 2> /dev/null)
    systemctl restart panel
    if panel_healthy; then
        return 0
    fi
    if [[ -n $previous && $previous != "$current" ]]; then
        echo_warn "Panel did not start on ${current:0:7}; rolling back to ${previous:0:7}"
        cp -a /opt/swizzin/core/custom /tmp/swizzin-custom.$$ 2> /dev/null
        panel_git reset -q --hard "$previous" >> ${log} 2>&1
        cp -a /tmp/swizzin-custom.$$/. /opt/swizzin/core/custom/ 2> /dev/null
        rm -rf /tmp/swizzin-custom.$$
        systemctl restart panel
        if panel_healthy; then
            echo_warn "Panel rolled back and running. Check: journalctl -u panel -n 80"
            return 0
        fi
    fi
    echo_warn "Panel is not responding. Check: journalctl -u panel -n 80   (classic UI: /classic)"
    return 0 # never fail box update because of the panel
}

# vnstat feeds the dashboard's daily / weekly / monthly / all-time transfer stats.
function panel_vnstat_setup() {
    if ! command -v vnstat > /dev/null 2>&1; then
        apt_install vnstat
    fi
    systemctl enable -q --now vnstat >> ${log} 2>&1 || true
}

function panel_smart_remove() {
    systemctl disable -q --now swizzin-smart.timer > /dev/null 2>&1
    rm -f /etc/systemd/system/swizzin-smart.service /etc/systemd/system/swizzin-smart.timer
    rm -rf /var/lib/swizzin/smart
    rmdir /var/lib/swizzin > /dev/null 2>&1
    systemctl daemon-reload
}

# Point an existing upstream panel checkout at the fork. Backs up /opt/swizzin first and leaves
# everything untouched if the fork can't be fetched.
function panel_use_fork_remote() {
    local current backup
    [[ -d /opt/swizzin/.git ]] || return 0
    current=$(panel_git remote get-url origin 2> /dev/null)
    if [[ -z $current ]]; then
        echo_warn "Could not read the panel's git remote; leaving the panel unchanged"
        return 0
    fi
    [[ $current == "$PANEL_REPO" ]] && return 0
    echo_progress_start "Switching panel source to $PANEL_REPO"
    backup="/root/swizzin-panel-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    tar -czf "$backup" -C /opt swizzin >> ${log} 2>&1 && echo_info "Panel backup: $backup"
    if ! panel_git fetch "$PANEL_REPO" "$PANEL_BRANCH" >> ${log} 2>&1; then
        echo_warn "Could not reach $PANEL_REPO; keeping the current panel"
        return 0
    fi
    cp -a /opt/swizzin/core/custom /opt/swizzin/core/custom.tmp
    panel_git remote set-url origin "$PANEL_REPO" >> ${log} 2>&1
    panel_git fetch origin "$PANEL_BRANCH" >> ${log} 2>&1
    panel_git checkout -q -B "$PANEL_BRANCH" "origin/$PANEL_BRANCH" >> ${log} 2>&1
    panel_git reset -q --hard "origin/$PANEL_BRANCH" >> ${log} 2>&1
    cp -a /opt/swizzin/core/custom.tmp/. /opt/swizzin/core/custom/ >> ${log} 2>&1
    rm -rf /opt/swizzin/core/custom.tmp
    echo_progress_done "Panel now tracks the fork"
}

# sudo rules for the panel (user swizzin). Once the installed panel calls the root-owned wrapper
# (/etc/swizzin/scripts/panel-systemctl), the old "systemctl enable *" rule is replaced: it let
# whoever controlled the panel process enable a unit file of their own, i.e. become root. Panels too
# old for the wrapper keep the old rule so their app buttons don't break; the next update tightens it.
# The file is checked with visudo before it replaces the current one, so sudo can never be broken.
panel_sudoers() {
    local wrapper=/etc/swizzin/scripts/panel-systemctl upgrade=/etc/swizzin/scripts/panel-upgrade tmp upg="" upg_alias=""
    tmp=$(mktemp /etc/sudoers.d/.panel.XXXXXX) || return 1
    if [[ -f $wrapper ]] && grep -q "panel-systemctl" /opt/swizzin/core/util.py 2> /dev/null; then
        chown root:root "$wrapper"
        chmod 755 "$wrapper"
        # app upgrades from the panel: only through panel-upgrade (fixed list of apps), and only once
        # the installed panel knows how to use it
        if [[ -f $upgrade && -f /etc/swizzin/scripts/panel-upgrade-run ]] &&
            grep -q "panel-upgrade" /opt/swizzin/core/updates.py 2> /dev/null; then
            chown root:root "$upgrade" /etc/swizzin/scripts/panel-upgrade-run /etc/swizzin/scripts/panel-updates-check
            chmod 755 "$upgrade" /etc/swizzin/scripts/panel-upgrade-run /etc/swizzin/scripts/panel-updates-check
            if [[ -f /etc/swizzin/scripts/panel-upgrade-lib ]]; then
                chown root:root /etc/swizzin/scripts/panel-upgrade-lib
                chmod 755 /etc/swizzin/scripts/panel-upgrade-lib
            fi
            upg=", PANELUPG"
            upg_alias="Cmnd_Alias   PANELUPG = $upgrade"
        fi
        cat > "$tmp" << EOSUD
# managed by swizzin (panel_sudoers): app control only through the checked wrapper
Defaults:swizzin !logfile
Defaults:swizzin !syslog
Defaults:swizzin !pam_session

Cmnd_Alias   CMNDS = /usr/bin/quota
Cmnd_Alias   PANELCTL = $wrapper
${upg_alias}

swizzin     ALL = (root) NOPASSWD: CMNDS, PANELCTL${upg}
EOSUD
    else
        cat > "$tmp" << EOSUD
#Defaults  env_keep -="HOME"
Defaults:swizzin !logfile
Defaults:swizzin !syslog
Defaults:swizzin !pam_session

Cmnd_Alias   CMNDS = /usr/bin/quota
Cmnd_Alias   SYSDCMNDS = /bin/systemctl start *, /bin/systemctl stop *, /bin/systemctl restart *, /bin/systemctl disable *, /bin/systemctl enable *

swizzin     ALL = (ALL) NOPASSWD: CMNDS, SYSDCMNDS
EOSUD
    fi
    chmod 440 "$tmp"
    if ! visudo -cqf "$tmp" > /dev/null 2>&1; then
        rm -f "$tmp"
        echo_warn "Panel sudo rules failed validation; kept the current ones"
        return 1
    fi
    if cmp -s "$tmp" /etc/sudoers.d/panel; then
        rm -f "$tmp"
        return 0
    fi
    mv -f "$tmp" /etc/sudoers.d/panel
}

